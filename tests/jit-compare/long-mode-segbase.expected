; What long-mode-segbase.asm leaves behind. Derived from the architecture rather than measured:
; wrmsr is ring 0, so the user space oracle the other fixtures use cannot run this one.
r8  = 1122334455667788     ; gs:[0] with the gs base at 0x7100
r9  = 99aabbccddeeff00     ; fs:[0] with the fs base at 0x7200
r10 = 10                   ; lea ignores the segment prefix
r11 = 1122334455667788     ; the moffs form takes the base too
r12 = 1122334455667788     ; and so does the source side of lodsq
r13 = 99aabbccddeeff00     ; after swapgs, the kernel base is the one in use
r14 = 1122334455667788     ; and swapgs again puts the original back
r15 = 123456789abcdef      ; a base above 4 GiB survives wrmsr and rdmsr
