; What long-mode-prefetchw.asm leaves behind. The three bits are the ones Windows checks before it
; will boot at all.
r8  = 1                    ; prefetchw is advertised
r9  = 1                    ; and lahf/sahf in 64-bit mode
r10 = 1                    ; and cmpxchg16b
r11 = 1122334455667788     ; the hint changed nothing
r12 = 1                    ; and did not fault on an unmapped address
