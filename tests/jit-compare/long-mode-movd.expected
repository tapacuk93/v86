; What long-mode-movd.asm leaves behind. Measured on a real x86-64 under rosetta, see
; long-mode-movd-oracle.c.
r8  = 0123456789abcdef     ; movq r64 -> xmm -> r64 keeps all 64 bits
r9  = 00000000deadbeef     ; movd cleared the rest of xmm1 rather than merging into it
r10 = 0123456789abcdef     ; the stored low half
r11 = 0123456789abcdef     ; and the high half movlhps filled
r12 = 0000000089abcdef     ; movd out writes 32 bits, so the top half of rax is cleared
